 "captions": [
  {
   "text": "Особь держит дверь. Счёт 1:10.",
   "label": "НАБЛЮДЕНИЕ №1",
   "from": 0,
   "to": 48,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Огонь по закрытой двери. Дверь побеждает.",
   "label": "НАБЛЮДЕНИЕ №2",
   "from": 48,
   "to": 102,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Счёт становится 1:11.",
   "label": "ТАБЛО",
   "from": 93,
   "to": 138,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Смена сторон. Включается общий голосовой чат.",
   "label": "ЗВУКИ ПРИРОДЫ",
   "from": 120,
   "to": 174,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Обе стаи начинают перекличку.",
   "label": "ЗВУКИ ПРИРОДЫ",
   "from": 174,
   "to": 228,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Особь сохраняет полное спокойствие.",
   "label": "ПОВЕДЕНИЕ",
   "from": 231,
   "to": 276,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Подготовка ко второй половине.",
   "label": "РИТУАЛ",
   "from": 276,
   "to": 336,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "…и облако, видимое с другого конца карты.",
   "label": "РИТУАЛ",
   "from": 336,
   "to": 387,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Стая исполняет танец. При счёте 1:11.",
   "label": "СТАЯ",
   "from": 399,
   "to": 495,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "До второй половины — 19 секунд.",
   "label": "ОТСЧЁТ",
   "from": 606,
   "to": 672,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Сбор ресурсов на камбэк.",
   "label": "ЗАКУПКА",
   "from": 678,
   "to": 744,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Сородичи замерли в ожидании сигнала.",
   "label": "СТАЯ",
   "from": 750,
   "to": 830,
   "style": "doc",
   "x": 0,
   "y": 0
  },
  {
   "text": "Разминка с ножом.",
